# LexNav Environment Variables Template
# Safe placeholder values only — NEVER commit active secrets or keys

# Google Cloud & Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Session & Storage Controls (Ephemeral Only)
SESSION_TTL_SECONDS=1800
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,docx,txt,md

# Rate Limiting & Safety
MAX_LLM_CALLS_PER_ACTION=5
RATE_LIMIT_REQUESTS_PER_MINUTE=60
ENABLE_PII_LOG_SCRUBBING=true
ENABLE_PROMPT_INJECTION_SHIELD=true

# Server & Network Ports
PORT=8080
HOST=0.0.0.0
NODE_ENV=production
