# LexNav Environment Variables
# Copy to .env and configure your Google Cloud & Gemini credentials

# Google Gemini Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Google Cloud Services (Document AI, Translation, Ephemeral GCS)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GCS_BUCKET_NAME=lexnav-ephemeral-docs
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Server Configuration
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# Ephemeral Session & Auto-Purge TTL
SESSION_TTL_SECONDS=1800
SESSION_REAPER_INTERVAL_SECONDS=60

# Rate Limiting & Safety
RATE_LIMIT_PER_MINUTE=20
ANALYZE_RATE_LIMIT_PER_MINUTE=5
MAX_CONCURRENT_SESSIONS_PER_IP=3

# CORS
CORS_ORIGINS=*
